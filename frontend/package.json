{
  "name": "foldr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "examples": "uv run --project ../origami python ../tools/build_examples.py",
    "wheel": "node scripts/build-wheel.mjs",
    "predev": "node scripts/ensure-examples.mjs && node scripts/build-wheel.mjs",
    "dev": "vite",
    "build": "node scripts/build-wheel.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
